# =============================================================================
# OpsMap — Environment Variables (example)
# Copy to .env and fill in real values. Never commit secrets.
# Frontend values go into frontend/.env.local (Next.js reads them from there).
# =============================================================================

# --- Supabase (public, browser-safe; needed for auth/data/storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, service role; bypasses RLS) ---
# Must never be prefixed with NEXT_PUBLIC_ and never used as the default
# database client. Used only for privileged server-side operations
# (storage writes, notification creation).
SUPABASE_SERVICE_ROLE_KEY=