# =============================================================================
# OpsMap — Environment Variables (example)
# Copy to .env and fill in real values. Never commit secrets.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Supabase PostgreSQL connection string) ---
DATABASE_URL=

# --- Redis (local: docker compose up redis) ---
REDIS_URL=redis://localhost:6379/0

# --- AI (optional; not required for core platform) ---
OPENAI_API_KEY=

# --- Backend ---
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Document uploads (local filesystem; path relative to backend working directory)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# --- Frontend (Next.js public vars use NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
